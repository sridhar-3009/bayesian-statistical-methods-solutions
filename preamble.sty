% ------------------------------------------------------------------ boxes
\tcbset{base/.style={enhanced, breakable, boxrule=0.6pt, arc=2.5pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt, before skip=0.7em, after skip=0.7em,
    fonttitle=\bfseries\small, coltitle=white, attach boxed title to top left={xshift=8pt, yshift=-7pt},
    boxed title style={arc=2pt, boxrule=0pt}}}

% The exact exercise text from the book
\newtcolorbox{problem}[1]{base, colback=bookbg, colframe=book,
  boxed title style={colback=book}, title={\faBook\ \ Exercise #1 \,(exact text from the book)}}
% The same problem in plain words
\newtcolorbox{restate}{base, colback=minebg, colframe=mine,
  boxed title style={colback=mine}, title={\faComment*\ \ In plain words}}
% Concepts needed before we start
\newtcolorbox{keyidea}{base, colback=ideabg, colframe=idea,
  boxed title style={colback=idea}, title={\faLightbulb\ \ Key idea}}
% Final answer
\newtcolorbox{answer}{base, colback=ansbg, colframe=ans,
  boxed title style={colback=ans}, title={\faCheckCircle\ \ Answer}}
% Lessons and common mistakes
\newtcolorbox{takeaway}{base, colback=warnbg, colframe=warn,
  boxed title style={colback=warn}, title={\faExclamationTriangle\ \ Takeaway \& common mistakes}}
% Definitions and facts recalled before the solution starts
\definecolor{recall}{HTML}{7D3C98}
\definecolor{recallbg}{HTML}{F5EEF8}
\newtcolorbox{recall}{base, colback=recallbg, colframe=recall,
  boxed title style={colback=recall}, title={\faGraduationCap\ \ Background you need}}
% Verifying an answer a second way
\definecolor{check}{HTML}{2E8B57}
\definecolor{checkbg}{HTML}{EAF7EE}
\newtcolorbox{sanity}{base, colback=checkbg, colframe=check,
  boxed title style={colback=check}, title={\faCheckDouble\ \ Sanity check}}
% A short "why does this step work?" remark inside a solution
\newcommand{\why}[1]{\par\begingroup\small\color{book}\faQuestionCircle[regular]\ \emph{Why?}\ #1\par\endgroup}

% A note about the source / reconstruction
\newtcolorbox{note}{base, colback=white, colframe=warn, boxrule=0.8pt, title={\faInfoCircle\ \ Note},
  boxed title style={colback=warn}}

\newcommand{\solution}{\par\smallskip{\large\bfseries\color{navy}\faPencil*\ \ Solution}\par}
\newcommand{\exercise}[1]{\clearpage\section{Exercise #1}}

